# Clinical Intelligence Platform — Phase 1 environment template.
# Copy to `.env` for local development. NEVER commit a populated `.env`.
# Production secrets live in the cloud provider's secret manager, not in files
# (docs/architecture/06-security-compliance.md §9).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
CIP_ENVIRONMENT=local
CIP_SERVICE_NAME=cip-ingestion
CIP_LOG_LEVEL=INFO
CIP_LOG_FORMAT=console          # console | json  (json in every deployed environment)
CIP_DEBUG=false

# ---------------------------------------------------------------------------
# PostgreSQL — operational store (docs/database/postgres-schema.sql)
# ---------------------------------------------------------------------------
CIP_POSTGRES__HOST=localhost
CIP_POSTGRES__PORT=5432
CIP_POSTGRES__DATABASE=cip
CIP_POSTGRES__USER=cip
CIP_POSTGRES__PASSWORD=change-me
CIP_POSTGRES__SSL_MODE=prefer   # `verify-full` is REQUIRED in every deployed environment
CIP_POSTGRES__POOL_SIZE=10
CIP_POSTGRES__MAX_OVERFLOW=5

# ---------------------------------------------------------------------------
# MongoDB — parsed-document artifact store (ADR-0005)
# ---------------------------------------------------------------------------
CIP_MONGO__URI=mongodb://localhost:27017
CIP_MONGO__DATABASE=cip
CIP_MONGO__SERVER_SELECTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Neo4j — graph store. Phase 1 establishes connectivity/health only; graph
# construction is Phase 2 (docs/roadmap/implementation-roadmap.md).
# ---------------------------------------------------------------------------
CIP_NEO4J__URI=bolt://localhost:7687
CIP_NEO4J__USER=neo4j
CIP_NEO4J__PASSWORD=change-me
CIP_NEO4J__DATABASE=neo4j

# ---------------------------------------------------------------------------
# Object storage — raw documents
# ---------------------------------------------------------------------------
CIP_STORAGE__BACKEND=local      # local | s3
CIP_STORAGE__LOCAL_ROOT=./var/storage
CIP_STORAGE__S3_BUCKET=
CIP_STORAGE__S3_REGION=
CIP_STORAGE__S3_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Authentication skeleton (docs/architecture/06-security-compliance.md §3)
# Phase 1 ships local HS256 verification plus the OIDC verifier seam; full
# enterprise IdP federation lands with the Identity service.
# ---------------------------------------------------------------------------
CIP_AUTH__ENABLED=true
CIP_AUTH__MODE=local_hs256      # local_hs256 | oidc
CIP_AUTH__JWT_SECRET=dev-only-secret-change-me
CIP_AUTH__JWT_ALGORITHM=HS256
CIP_AUTH__JWT_ISSUER=cip-local
CIP_AUTH__JWT_AUDIENCE=cip-api
CIP_AUTH__JWKS_URL=
CIP_AUTH__LEEWAY_SECONDS=30

# ---------------------------------------------------------------------------
# Ingestion limits & pipeline tuning
# ---------------------------------------------------------------------------
CIP_INGESTION__MAX_UPLOAD_BYTES=104857600     # 100 MiB
CIP_INGESTION__CHUNK_TARGET_TOKENS=384
CIP_INGESTION__CHUNK_MIN_TOKENS=64
CIP_INGESTION__CHUNK_MAX_TOKENS=512
CIP_INGESTION__CHUNK_OVERLAP_RATIO=0.12
CIP_INGESTION__OCR_ENABLED=true
CIP_INGESTION__OCR_DPI=300
CIP_INGESTION__OCR_LANGUAGE=eng
CIP_INGESTION__OCR_MIN_TEXT_CHARS_PER_PAGE=48 # below this a PDF page is treated as scanned
CIP_INGESTION__QUALITY_MIN_SCORE=0.60
